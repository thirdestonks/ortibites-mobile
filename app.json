{
  "expo": {
    "name": "ortibites",
    "slug": "ortibites-mobile",
    "scheme": "ortibites",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#151c2e"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.thirdestonks.ortibitesmobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow Ortibites to save your Wrapped pass to your photos.",
          "photosPermission": false,
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#09090b",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1089026b-545f-4c57-8258-085eeb989f46"
      }
    }
  }
}
